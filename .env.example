RUNPOD_API_KEY=<your-runpod-api-key>

# Optional RunPod GPU override. Defaults remain NVIDIA A40 / 48 GB.
# Set both values together for an explicitly qualified alternate GPU.
# RUNPOD_GPU_ID=NVIDIA GeForce RTX 3090
# RUNPOD_GPU_MEMORY_GB=24

# Local Ollama endpoints
LME_BURST_1_URL=http://127.0.0.1:11441
LME_BURST_2_URL=http://127.0.0.1:11442
LME_BURST_3_URL=http://127.0.0.1:11443
LME_BURST_4_URL=http://127.0.0.1:11444
LME_BURST_5_URL=http://127.0.0.1:11445

# RunPod worker 1
RUNPOD_BURST_1_HOST=<direct-ip>
RUNPOD_BURST_1_SSH_PORT=<external-port>

# RunPod worker 2
RUNPOD_BURST_2_HOST=<direct-ip>
RUNPOD_BURST_2_SSH_PORT=<external-port>

# RunPod worker 3
RUNPOD_BURST_3_HOST=<direct-ip>
RUNPOD_BURST_3_SSH_PORT=<external-port>

# RunPod worker 4
RUNPOD_BURST_4_HOST=<direct-ip>
RUNPOD_BURST_4_SSH_PORT=<external-port>

# RunPod worker 5
RUNPOD_BURST_5_HOST=<direct-ip>
RUNPOD_BURST_5_SSH_PORT=<external-port>

# LME runner progress heartbeat interval in seconds.
# Set to 0 to disable.
LME_HEARTBEAT_SECONDS=10
