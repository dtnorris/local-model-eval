#!/usr/bin/env ruby
# frozen_string_literal: true

ROOT = File.expand_path("..", __dir__)
$LOAD_PATH.unshift File.join(ROOT, "lib")
require "local_model_evaluation"

queue = ARGV.fetch(0) do
  warn "Usage: bin/preflight-production-backlog-sources production_backlog/QUEUE"
  exit 2
end

ok = LocalModelEvaluation::ProductionBacklogSourcePreflight.new(root: ROOT).run(queue)
exit(ok ? 0 : 1)
