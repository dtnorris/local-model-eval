#!/usr/bin/env ruby
# frozen_string_literal: true

require "csv"
require "digest"
require "fileutils"
require "json"
require "open3"
require "optparse"
require "pathname"
require "tmpdir"
require "time"
require "yaml"

ROOT = File.expand_path("..", __dir__)
SCORER_REPO = File.expand_path(ENV.fetch("AF_SCORER_REPO", "../af-cli-scoring-utility"), ROOT)
QUALIFIED_PATH = File.join(ROOT, "production_backlog", "qualified_seriousness.yml")
DIMENSION = "Seriousness"
EXPECTED_BASELINE = "c5f27d1060623938fa4d338340647396fb9fdc16"
PROTECTED_SCORER_FILES = %w[
  lib/af_scoring/afao.rb
  lib/af_scoring/prompt_builder.rb
  lib/af_scoring/phase6_seriousness_guardrail.rb
].freeze
RESET_FORBIDDEN_GUARDRAIL_MARKERS = [
  "# Seriousness Adversarial-Play Guardrail",
  "# Seriousness Tonal-Hierarchy / Proxy-Weighting Guardrail",
  "# Seriousness Direct Register-Comparison Decision Guardrail v0.3"
].freeze

def abort_with(message)
  warn "ERROR: #{message}"
  exit 1
end

def blank?(value)
  value.nil? || value.to_s.strip.empty?
end

def integer_or_nil(value)
  return nil if blank?(value)
  Integer(Float(value))
rescue ArgumentError, TypeError
  nil
end

def canonical_header(value)
  header = value.to_s.strip
  header == "ADV - ID" ? "Adventure ID" : header
end

def git_head(repo)
  out, _err, status = Open3.capture3("git", "-C", repo, "rev-parse", "HEAD")
  status.success? ? out.strip : nil
end

def git_ancestor?(repo, ancestor, descendant = "HEAD")
  _out, _err, status = Open3.capture3(
    "git", "-C", repo, "merge-base", "--is-ancestor", ancestor, descendant
  )
  status.success?
end

def git_paths_clean?(repo, *paths)
  _out, _err, unstaged = Open3.capture3("git", "-C", repo, "diff", "--quiet", "--", *paths)
  _out, _err, staged = Open3.capture3("git", "-C", repo, "diff", "--cached", "--quiet", "--", *paths)
  unstaged.success? && staged.success?
end

def git_paths_unchanged?(repo, baseline, *paths)
  _out, _err, status = Open3.capture3(
    "git", "-C", repo, "diff", "--quiet", "#{baseline}..HEAD", "--", *paths
  )
  status.success?
end

def scorer_catalog_path(scorer_repo, runtime_config_path)
  require File.join(scorer_repo, "lib", "af_scoring", "errors")
  require File.join(scorer_repo, "lib", "af_scoring", "config")
  AFScoring::Config.new(
    project_root: scorer_repo,
    config_path: runtime_config_path
  ).catalog_path
end

def reserved_seriousness_pairs(root, current_queue:)
  reserved = {}
  Dir.glob(File.join(root, "production_backlog", "**", "*case_index.csv")).sort.each do |path|
    relative = path.delete_prefix("#{root}/")
    next if relative.start_with?("production_backlog/#{current_queue}/")

    begin
      rows = CSV.read(path, headers: true, encoding: "UTF-8")
      next unless rows.headers&.include?("adventure_id") && rows.headers&.include?("dimension")

      rows.each do |row|
        next unless row["dimension"].to_s.strip == DIMENSION
        id = row["adventure_id"].to_s.strip
        reserved[id] ||= "case_index:#{relative}" unless id.empty?
      end
    rescue CSV::MalformedCSVError => e
      warn "WARNING: could not read #{path}: #{e.message}"
    end
  end
  reserved
end

def validate_runtime_config!(runtime_config_path, qualification)
  abort_with("missing runtime config #{runtime_config_path}") unless File.file?(runtime_config_path)

  config = YAML.safe_load_file(runtime_config_path) || {}
  llm = config.fetch("llm")
  abort_with("runtime provider must be ollama") unless llm.fetch("provider") == "ollama"
  abort_with("runtime model changed") unless llm.fetch("model") == qualification.fetch("ollama_model")
  unless llm.fetch("reasoning_effort") == qualification.fetch("reasoning_effort")
    abort_with("runtime reasoning_effort changed")
  end
  unless Integer(llm.fetch("max_tokens")) == Integer(qualification.fetch("max_tokens"))
    abort_with("runtime max_tokens changed")
  end
rescue KeyError => e
  abort_with("invalid runtime config: #{e.message}")
end

def source_preflight(scorer_repo, runtime_config_path, adventure_id, ollama_model)
  Dir.mktmpdir("af-seriousness-preflight") do |dir|
    rendered = File.join(dir, "preflight.json")
    runtime_rel = Pathname.new(runtime_config_path).relative_path_from(Pathname.new(scorer_repo)).to_s
    command = [
      File.join(scorer_repo, "bin", "af-score"),
      "--config", runtime_rel,
      "--model", ollama_model,
      "--dimension", DIMENSION,
      "--preflight",
      "--render-preflight", rendered,
      adventure_id
    ]
    stdout, stderr, status = Open3.capture3(*command, chdir: scorer_repo)
    detail = [stdout, stderr].join("\n").strip
    return [false, detail, nil] unless status.success?

    data = JSON.parse(File.read(rendered))
    targets = data.fetch("targets")
    raise KeyError, "expected exactly one focused target" unless targets.length == 1
    target = targets.fetch(0)
    metadata = data.fetch("run_metadata")
    prompt = target.fetch("prompt")
    fingerprint = {
      "prompt_sha256" => target.fetch("prompt_sha256"),
      "schema_sha256" => target.fetch("schema_sha256"),
      "source_file" => data.fetch("source_file"),
      "source_scope" => data.fetch("source_scope"),
      "afao_version" => metadata.fetch("afao_version"),
      "provider" => metadata.fetch("provider"),
      "model" => metadata.fetch("model"),
      "reasoning_effort" => metadata.fetch("reasoning_effort"),
      "dimensions" => target.fetch("dimensions"),
      "prompt_instructions" => prompt.fetch("instructions"),
      "prompt_input" => prompt.fetch("input")
    }
    [true, detail, fingerprint]
  rescue JSON::ParserError, KeyError => e
    [false, "invalid rendered preflight: #{e.class}: #{e.message}", nil]
  end
end

def focused_rubric_block(prompt_input)
  match = prompt_input.match(
    /^# AFAO [^\n]+ Rubric for This Focused Pass\s*$\n\n(.*?)\n\n^# Focused Assessment Task\s*$/m
  )
  match && match[1]
end

def validate_preflight_contract!(fingerprint, qualification, adventure_id)
  failures = []
  failures << "AFAO #{fingerprint['afao_version'].inspect}" unless fingerprint["afao_version"] == qualification.fetch("afao_version")
  failures << "provider #{fingerprint['provider'].inspect}" unless fingerprint["provider"] == "ollama"
  failures << "model #{fingerprint['model'].inspect}" unless fingerprint["model"] == qualification.fetch("ollama_model")
  failures << "reasoning #{fingerprint['reasoning_effort'].inspect}" unless fingerprint["reasoning_effort"] == qualification.fetch("reasoning_effort")
  failures << "dimensions #{fingerprint['dimensions'].inspect}" unless fingerprint["dimensions"] == [DIMENSION]

  rubric = focused_rubric_block(fingerprint.fetch("prompt_input"))
  if rubric.nil?
    failures << "could not isolate focused AFAO rubric"
  else
    failures << "Seriousness rubric heading missing" unless rubric.match?(/^###\s+\d+\.\s+Seriousness\s*$/)
    if rubric.match?(/^####\s+Calibration Benchmarks\s*$/i)
      failures << "Seriousness Calibration Benchmarks subsection leaked into focused rubric"
    end
    RESET_FORBIDDEN_GUARDRAIL_MARKERS.each do |marker|
      failures << "legacy Seriousness guardrail #{marker.inspect}" if rubric.include?(marker)
    end
  end

  abort_with("#{adventure_id} rendered Seriousness contract mismatch: #{failures.join(', ')}") unless failures.empty?
end

def yaml_manifest(queue:, adv:, scorer_rel:, runtime_config_arg:, qualification:)
  <<~YAML
    name: #{queue}-qwen-seriousness-adv#{adv.fetch("id").split("-").last.downcase}-v1
    purpose: >
      Interruptible AdventureFinder local production scoring. Produce one proposed
      Seriousness assessment for canonical #{adv.fetch("id")} using the locally
      qualified qwen3.6:35b-a3b reset-only Seriousness profile. The accepted AMC
      Seriousness value was blank when this queue was generated.
    dispatch: pool

    models:
      - #{qualification.fetch("model_alias")}

    dimension: "#{qualification.fetch("dimension")}"

    adventures:
      - #{adv.fetch("id")}

    replicates: 1

    workers:
      - mac

    required_worker_labels:
      - local

    scorer:
      repo: #{scorer_rel}
      mode: positional
      extra_args:
        - --config
        - #{runtime_config_arg}

    production_contract:
      contract_type: #{qualification.fetch("contract_type")}
      disposition: local-qualified-background
      queue: #{queue}
      candidate_model: #{qualification.fetch("model_alias")}
      qualified_profile: #{qualification.fetch("profile")}
      qualified_scorer_baseline: #{qualification.fetch("qualified_scorer_baseline")}
      reasoning_effort: #{qualification.fetch("reasoning_effort")}
      max_tokens: #{qualification.fetch("max_tokens")}
      temperature: #{qualification.fetch("temperature")}
      replicate_count: 1
      no_favorable_rerun: true
      external_api_cost_usd: 0.0

    success_criteria:
      - Structured scorer output validates and remains grounded to the complete canonical adventure source unit.
      - Use the frozen reset-only Seriousness profile with qwen3.6:35b-a3b.
      - Use reasoning effort low, temperature 0, and max tokens 16384.
      - Preserve the single completed sample as a proposed production assessment pending QC/ingestion.
      - Do not use an existing accepted Seriousness score or calibration target as expected-answer context.

    stop_conditions:
      - Do not rerun a completed case to seek a more favorable sample.
      - Queue-level repeated operational failures trigger the background runner circuit breaker.

    cost_cap_usd: 0.01
  YAML
end

abort_with("missing qualification contract #{QUALIFIED_PATH}") unless File.file?(QUALIFIED_PATH)
qualification = YAML.safe_load_file(QUALIFIED_PATH)
RUNTIME_CONFIG_PATH = File.join(ROOT, qualification.fetch("runtime_config_path"))

options = { queue: nil, pack_size: 50, force: false }
OptionParser.new do |opts|
  opts.banner = "Usage: bin/prepare-production-backlog-seriousness --queue NAME [options]"
  opts.on("--queue NAME", "Queue name (required)") { |v| options[:queue] = v }
  opts.on("--pack-size N", Integer, "Manifest count per operational pack (default 50)") { |v| options[:pack_size] = v }
  opts.on("--force", "Replace an unstarted queue with the same name") { options[:force] = true }
end.parse!

queue = options[:queue].to_s
abort_with("--queue is required") if queue.empty?
abort_with("invalid queue name #{queue.inspect}") unless queue.match?(/\A[a-z0-9][a-z0-9._-]*\z/)
abort_with("--pack-size must be >= 1") if options[:pack_size] < 1
abort_with("scorer checkout not found: #{SCORER_REPO}") unless File.directory?(File.join(SCORER_REPO, ".git"))
abort_with("qualification contract type changed") unless qualification.fetch("contract_type") == "seriousness_local_qualified_v1"
abort_with("qualification dimension changed") unless qualification.fetch("dimension") == DIMENSION
abort_with("qualification profile changed") unless qualification.fetch("profile") == "seriousness-reset-only"
abort_with("model alias changed") unless qualification.fetch("model_alias") == "qwen"
abort_with("Ollama model changed") unless qualification.fetch("ollama_model") == "qwen3.6:35b-a3b"
abort_with("qualified scorer baseline changed") unless qualification.fetch("qualified_scorer_baseline") == EXPECTED_BASELINE
abort_with("AFAO version changed") unless qualification.fetch("afao_version") == "1.6.1"
abort_with("production replicate contract changed") unless Integer(qualification.fetch("replicates")) == 1
abort_with("production page envelope must remain exclusive <100") unless Integer(qualification.fetch("max_page_count_exclusive")) == 100
abort_with("reasoning profile must remain low") unless qualification.fetch("reasoning_effort") == "low"
abort_with("max token contract must remain 16384") unless Integer(qualification.fetch("max_tokens")) == 16_384
abort_with("temperature contract must remain 0") unless Float(qualification.fetch("temperature")) == 0.0
abort_with("favorable reruns must remain disabled") unless qualification.fetch("no_favorable_rerun") == true
validate_runtime_config!(RUNTIME_CONFIG_PATH, qualification)

baseline = qualification.fetch("qualified_scorer_baseline")
abort_with("scorer HEAD is not a descendant of qualified Seriousness baseline #{baseline}") unless git_ancestor?(SCORER_REPO, baseline)
unless git_paths_unchanged?(SCORER_REPO, baseline, *PROTECTED_SCORER_FILES)
  abort_with("qualified Seriousness implementation changed after #{baseline}")
end
unless git_paths_clean?(SCORER_REPO, *PROTECTED_SCORER_FILES)
  abort_with("working tree changes touch qualified Seriousness implementation")
end

queue_dir = File.join(ROOT, "production_backlog", queue)
experiment_dir = File.join(ROOT, "experiments", queue)
if File.exist?(queue_dir) || File.exist?(experiment_dir)
  abort_with("queue already exists; use --force to replace it") unless options[:force]
  prior_output = Dir.glob(File.join(ROOT, "output", "#{queue}-qwen-seriousness-*", "runs", "*", "metadata.json"))
  abort_with("refusing --force because inference output already exists for #{queue}") unless prior_output.empty?
end

catalog_path = scorer_catalog_path(SCORER_REPO, RUNTIME_CONFIG_PATH)
abort_with("configured AMC does not exist: #{catalog_path}") unless File.file?(catalog_path)
catalog_sha = Digest::SHA256.file(catalog_path).hexdigest

require File.join(SCORER_REPO, "lib", "af_scoring", "errors")
require File.join(SCORER_REPO, "lib", "af_scoring", "xlsx_reader")
rows = AFScoring::XlsxReader.new(catalog_path).rows(sheet_name: "Adventure Catalog")
abort_with("AMC Adventure Catalog sheet is empty") if rows.empty?
headers = rows.shift.map { |v| canonical_header(v) }
required_headers = [
  "Adventure ID", "Adventure Title", "Source Book", "Book Publisher",
  "Page Count", "Start Page", "End Page", qualification.fetch("catalog_column")
]
missing = required_headers - headers
abort_with("AMC missing required columns: #{missing.join(', ')}") unless missing.empty?

reserved = reserved_seriousness_pairs(ROOT, current_queue: queue)
audit = []
candidates = []
catalog_ids = []
prepopulated = 0
under_limit = 0

rows.each do |row|
  values = headers.zip(row).to_h
  id = values["Adventure ID"].to_s.strip
  next if id.empty?
  catalog_ids << id

  page_count = integer_or_nil(values["Page Count"])
  start_page = integer_or_nil(values["Start Page"])
  end_page = integer_or_nil(values["End Page"])
  page_count ||= (end_page - start_page + 1) if start_page && end_page && end_page >= start_page

  record = {
    "id" => id,
    "title" => values["Adventure Title"].to_s,
    "source_book" => values["Source Book"].to_s,
    "publisher" => values["Book Publisher"].to_s,
    "page_count" => page_count,
    "start_page" => start_page,
    "end_page" => end_page
  }

  reason = nil
  max_page_count = Integer(qualification.fetch("max_page_count_exclusive"))
  if page_count.nil? || page_count <= 0
    reason = "page_count_missing"
  elsif page_count >= max_page_count
    reason = "outside_production_page_envelope"
  else
    under_limit += 1
    if !blank?(values[qualification.fetch("catalog_column")])
      prepopulated += 1
      reason = "accepted_seriousness_present"
    elsif reserved.key?(id)
      reason = "reserved_seriousness_pair:#{reserved.fetch(id)}"
    end
  end

  if reason
    audit << record.merge("decision" => "REJECT", "reason" => reason)
  else
    candidates << record
  end
end

duplicates = catalog_ids.tally.select { |_id, count| count > 1 }
abort_with("AMC duplicate Adventure IDs: #{duplicates.keys.join(', ')}") unless duplicates.empty?

$stdout.sync = true
source_failures = []
selected = []
candidates.each_with_index do |record, index|
  puts format(
    "PREFLIGHT %3d/%d  %-9s  %3s pages  %s",
    index + 1, candidates.length, record.fetch("id"),
    record.fetch("page_count") || "?", record.fetch("title")
  )
  ok, detail, fingerprint = source_preflight(
    SCORER_REPO,
    RUNTIME_CONFIG_PATH,
    record.fetch("id"),
    qualification.fetch("ollama_model")
  )

  if ok
    validate_preflight_contract!(fingerprint, qualification, record.fetch("id"))
    selected << record.merge(fingerprint.reject { |k, _| k.start_with?("prompt_") && k != "prompt_sha256" })
    puts format("PASS      %3d/%d  %-9s  %s", index + 1, candidates.length, record.fetch("id"), record.fetch("title"))
  else
    puts format("REJECT    %3d/%d  %-9s  %s", index + 1, candidates.length, record.fetch("id"), record.fetch("title"))
    source_failures << record.merge("detail" => detail)
  end
end

unless source_failures.empty?
  warn
  warn "ERROR: #{source_failures.length} blank-Seriousness adventure(s) failed zero-inference source preflight."
  source_failures.each { |r| warn "  #{r.fetch('id')} — #{r.fetch('title')}: #{r.fetch('detail')}" }
  abort_with("B012 is intended to exhaust the current source-ready blank-Seriousness population; no queue was written")
end

FileUtils.rm_rf(queue_dir) if options[:force]
FileUtils.rm_rf(experiment_dir) if options[:force]
FileUtils.mkdir_p(queue_dir)
FileUtils.mkdir_p(experiment_dir)

selected.each do |record|
  audit << record.merge("decision" => "SELECT", "reason" => "blank_seriousness_source_preflight_pass")
end

qualification_sha = Digest::SHA256.file(QUALIFIED_PATH).hexdigest
runtime_config_sha = Digest::SHA256.file(RUNTIME_CONFIG_PATH).hexdigest
snapshot = {
  "version" => 1,
  "contract_type" => qualification.fetch("contract_type"),
  "queue" => queue,
  "generated_at" => Time.now.iso8601,
  "local_model_eval_commit" => git_head(ROOT),
  "scorer_commit" => git_head(SCORER_REPO),
  "scorer_repo_path" => Pathname.new(SCORER_REPO).relative_path_from(Pathname.new(ROOT)).to_s,
  "qualification_contract_path" => Pathname.new(QUALIFIED_PATH).relative_path_from(Pathname.new(ROOT)).to_s,
  "qualification_contract_sha256" => qualification_sha,
  "qualification_contract" => qualification,
  "runtime_config_path" => qualification.fetch("runtime_config_path"),
  "runtime_config_sha256" => runtime_config_sha,
  "catalog_path" => catalog_path,
  "catalog_filename" => File.basename(catalog_path),
  "catalog_sha256" => catalog_sha,
  "catalog_total_adventures" => catalog_ids.length,
  "catalog_under_page_limit" => under_limit,
  "catalog_prepopulated_seriousness" => prepopulated,
  "catalog_reserved_seriousness" => reserved.length,
  "catalog_eligible_blank_seriousness" => selected.length,
  "dimension" => DIMENSION,
  "profile" => qualification.fetch("profile"),
  "model_alias" => qualification.fetch("model_alias"),
  "ollama_model" => qualification.fetch("ollama_model"),
  "max_page_count_exclusive" => qualification.fetch("max_page_count_exclusive"),
  "reasoning_effort" => qualification.fetch("reasoning_effort"),
  "max_tokens" => qualification.fetch("max_tokens"),
  "temperature" => qualification.fetch("temperature"),
  "pack_size" => options[:pack_size],
  "expected_calls" => selected.length,
  "selected_adventures" => selected
}
File.write(File.join(queue_dir, "snapshot.yml"), YAML.dump(snapshot))

audit_headers = %w[
  adventure_id adventure_title source_book publisher page_count decision reason
]
CSV.open(File.join(queue_dir, "candidate_audit.csv"), "w") do |csv|
  csv << audit_headers
  audit.sort_by { |r| r["id"] }.each do |r|
    csv << [
      r["id"], r["title"], r["source_book"], r["publisher"],
      r["page_count"], r["decision"], r["reason"]
    ]
  end
end

case_headers = %w[
  case_index pack_index pack_case_index adventure_id adventure_title
  source_book publisher page_count dimension profile manifest_path
]
case_rows = []
all_run_paths = []
scorer_rel = Pathname.new(SCORER_REPO).relative_path_from(Pathname.new(experiment_dir)).to_s
runtime_config_arg = '${LME_REPO}/' + qualification.fetch("runtime_config_path")

selected.each_slice(options[:pack_size]).with_index(1) do |pack_adventures, pack_index|
  pack_rows = []
  pack_paths = []
  pack_adventures.each_with_index do |adv, pack_offset|
    case_index = case_rows.length + 1
    filename = "#{queue}-qwen-seriousness-adv#{adv.fetch('id').split('-').last.downcase}-v1.yml"
    relative_path = File.join("experiments", queue, filename)
    File.write(
      File.join(experiment_dir, filename),
      yaml_manifest(
        queue: queue,
        adv: adv,
        scorer_rel: scorer_rel,
        runtime_config_arg: runtime_config_arg,
        qualification: qualification
      )
    )
    row = [
      case_index, pack_index, pack_offset + 1, adv.fetch("id"), adv.fetch("title"),
      adv.fetch("source_book"), adv.fetch("publisher"), adv.fetch("page_count"),
      DIMENSION, qualification.fetch("profile"), relative_path
    ]
    case_rows << row
    pack_rows << row
    pack_paths << relative_path
    all_run_paths << relative_path
    puts format("WRITE %3d/%d  %s", case_index, selected.length, relative_path)
  end

  pack_name = format("pack-%03d", pack_index)
  CSV.open(File.join(queue_dir, "#{pack_name}_case_index.csv"), "w") do |csv|
    csv << case_headers
    pack_rows.each { |row| csv << row }
  end
  File.write(File.join(queue_dir, "#{pack_name}_run_order.txt"), pack_paths.join("\n") + "\n")
end

CSV.open(File.join(queue_dir, "case_index.csv"), "w") do |csv|
  csv << case_headers
  case_rows.each { |row| csv << row }
end
File.write(File.join(queue_dir, "run_order.txt"), all_run_paths.join("\n") + "\n")

puts
puts "SERIOUSNESS PRODUCTION BACKLOG PREPARED — NO INFERENCE WAS RUN"
puts "Queue: production_backlog/#{queue}"
puts "AMC: #{File.basename(catalog_path)} / #{catalog_sha}"
puts "AMC total: #{catalog_ids.length}"
puts "Production envelope: Page Count < #{qualification.fetch('max_page_count_exclusive')} (#{under_limit} adventures)"
puts "Accepted Seriousness already present: #{prepopulated}"
puts "Prior production Seriousness reservations: #{reserved.length}"
puts "Blank eligible adventures/calls: #{selected.length}"
puts "Packs: #{(selected.length.to_f / options[:pack_size]).ceil} (pack size #{options[:pack_size]})"
puts "Model: #{qualification.fetch('model_alias')} => #{qualification.fetch('ollama_model')}"
puts "Dimension: #{DIMENSION}"
puts "Profile: #{qualification.fetch('profile')}"
puts "Runtime: reasoning=#{qualification.fetch('reasoning_effort')} temperature=#{qualification.fetch('temperature')} max_tokens=#{qualification.fetch('max_tokens')}"
puts "Qualified scorer baseline: #{qualification.fetch('qualified_scorer_baseline')}"
puts "Frozen runtime scorer commit: #{snapshot.fetch('scorer_commit')}"
puts "Scorer checkout: #{SCORER_REPO}"
puts "External/API inference cost: $0"
puts
puts "Next:"
puts "  ./verify_production_backlog_seriousness.sh production_backlog/#{queue}"
