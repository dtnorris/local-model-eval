#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "local_model_evaluation"

ROOT = File.expand_path("..", __dir__)

index_path = ARGV.shift
abort "Usage: bin/lme-phase6-preflight INDEX.csv" unless index_path && ARGV.empty?

workers_path = File.join(ROOT, "config", "workers.yml")
abort "Missing #{workers_path}; copy config/workers.example.yml first." unless File.file?(workers_path)

worker_data = LocalModelEvaluation::Config.load_yaml(workers_path)
workers = worker_data.fetch("workers").to_h do |name, attrs|
  [name.to_s, LocalModelEvaluation::Worker.new(name, attrs)]
end

model_data = LocalModelEvaluation::Config.load_yaml(File.join(ROOT, "config", "models.yml"))
models = model_data.fetch("models").transform_keys(&:to_s)

begin
  LocalModelEvaluation::Phase6Preflight.new(
    index_path: index_path,
    models: models,
    workers: workers,
    output_root: File.join(ROOT, "output")
  ).run
rescue LocalModelEvaluation::Phase6Preflight::ValidationError => e
  warn e.message
  exit 1
end
