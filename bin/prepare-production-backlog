#!/usr/bin/env ruby
# frozen_string_literal: true

require "csv"
require "digest"
require "fileutils"
require "json"
require "open3"
require "optparse"
require "pathname"
require "tmpdir"
require "time"
require "yaml"

ROOT = File.expand_path("..", __dir__)
SCORER_REPO = File.expand_path(
  ENV.fetch("AF_SCORER_REPO", "../af-cli-scoring-utility"),
  ROOT
)
QUALIFIED_PATH = File.join(ROOT, "production_backlog", "qualified_dimensions.yml")
POLICY_PATH = File.join(ROOT, "production_backlog", "selection_policy.yml")

def abort_with(message)
  warn "ERROR: #{message}"
  exit 1
end

def blank?(value)
  value.nil? || value.to_s.strip.empty?
end

def integer_or_nil(value)
  return nil if blank?(value)
  Integer(Float(value))
rescue ArgumentError, TypeError
  nil
end

def canonical_header(value)
  header = value.to_s.strip
  header == "ADV - ID" ? "Adventure ID" : header
end

def git_head(repo)
  out, _err, status = Open3.capture3("git", "-C", repo, "rev-parse", "HEAD")
  status.success? ? out.strip : nil
end

def scorer_catalog_path(scorer_repo)
  config_path = File.join(scorer_repo, "config", "default.yml")
  abort_with("missing scorer config: #{config_path}") unless File.file?(config_path)
  config = YAML.safe_load_file(config_path)
  relative = config.dig("files", "catalog")
  abort_with("scorer config files.catalog is missing") if blank?(relative)
  File.expand_path(relative.to_s, scorer_repo)
end

def reserved_adventure_ids(root)
  ids = {}

  Dir.glob(File.join(root, "**", "*case_index.csv")).sort.each do |path|
    begin
      rows = CSV.read(path, headers: true, encoding: "UTF-8")
      next unless rows.headers&.include?("adventure_id")
      rows.each do |row|
        id = row["adventure_id"].to_s.strip
        ids[id] = "case_index:#{path.delete_prefix("#{root}/")}" unless id.empty?
      end
    rescue CSV::MalformedCSVError => e
      warn "WARNING: could not read #{path}: #{e.message}"
    end
  end

  Dir.glob(File.join(root, "output", "**", "metadata.json")).sort.each do |path|
    begin
      metadata = JSON.parse(File.read(path))
      id = metadata["adventure"].to_s.strip
      next if id.empty?
      ids[id] ||= "local_output:#{path.delete_prefix("#{root}/")}"
    rescue JSON::ParserError
      next
    end
  end

  ids
end

def source_preflight(scorer_repo, adventure_id, ollama_model)
  command = [
    File.join(scorer_repo, "bin", "af-score"),
    "--model", ollama_model,
    "--dimension", "Combat Emphasis",
    "--preflight",
    adventure_id
  ]
  stdout, stderr, status = Open3.capture3(*command, chdir: scorer_repo)
  [status.success?, [stdout, stderr].join("\n").strip]
end

def yaml_manifest(queue:, adv:, dimension:, scorer_rel:)
  profile_block =
    if dimension["env_name"]
      <<~YAML
        phase6_contract:
          prompt_profile:
            version: #{dimension.fetch("profile")}
            env_name: #{dimension.fetch("env_name")}
            env_value: #{dimension.fetch("env_value")}

      YAML
    else
      ""
    end

  <<~YAML
    name: #{queue}-qwen-#{dimension.fetch("slug")}-adv#{adv.fetch("id").split("-").last.downcase}-v1
    purpose: >
      Interruptible AdventureFinder background production scoring. Produce one
      proposed assessment for canonical #{adv.fetch("id")} on the locally
      qualified AFAO dimension #{dimension.fetch("name")}, using Qwen3.6 35B-A3B
      with one replicate. The queue was selected from blank qualified-dimension
      AMC cells and frozen before inference.
    dispatch: pool

    models:
      - qwen

    dimension: #{dimension.fetch("name")}

    adventures:
      - #{adv.fetch("id")}

    replicates: 1

    workers:
      - mac

    required_worker_labels:
      - local

    scorer:
      repo: #{scorer_rel}
      mode: positional
      extra_args: []

    #{profile_block}production_contract:
      disposition: local-qualified-background
      queue: #{queue}
      candidate_model: qwen
      qualified_profile: #{dimension.fetch("profile")}
      replicate_count: 1
      no_favorable_rerun: true
      external_api_cost_usd: 0.0

    success_criteria:
      - Structured scorer output validates and remains grounded to the canonical adventure source unit.
      - Use the frozen locally qualified profile for #{dimension.fetch("name")}.
      - Preserve the single completed sample as a proposed production assessment pending QC/ingestion.
      - Do not use an existing accepted score or calibration target as expected-answer context.

    stop_conditions:
      - Do not rerun a completed case to seek a more favorable sample.
      - Queue-level repeated operational failures trigger the background runner circuit breaker.

    cost_cap_usd: 0.01
  YAML
end

qualified = YAML.safe_load_file(QUALIFIED_PATH)
policy = YAML.safe_load_file(POLICY_PATH)

options = {
  queue: nil,
  packs: Integer(policy.fetch("pack_count")),
  per_pack: Integer(policy.fetch("adventures_per_pack")),
  max_pages: Integer(policy.fetch("max_page_count")),
  force: false
}

OptionParser.new do |opts|
  opts.banner = "Usage: bin/prepare-production-backlog --queue NAME [options]"
  opts.on("--queue NAME", "Queue name (required)") { |v| options[:queue] = v }
  opts.on("--packs N", Integer, "Number of packs (default #{options[:packs]})") { |v| options[:packs] = v }
  opts.on("--adventures-per-pack N", Integer, "Adventures per pack (default #{options[:per_pack]})") { |v| options[:per_pack] = v }
  opts.on("--max-pages N", Integer, "Maximum AMC page count (default #{options[:max_pages]})") { |v| options[:max_pages] = v }
  opts.on("--force", "Replace an existing queue with the same name") { options[:force] = true }
end.parse!

queue = options[:queue].to_s
abort_with("--queue is required") if queue.empty?
abort_with("invalid queue name #{queue.inspect}") unless queue.match?(/\A[a-z0-9][a-z0-9._-]*\z/)
abort_with("--packs must be >= 1") if options[:packs] < 1
abort_with("--adventures-per-pack must be >= 1") if options[:per_pack] < 1
abort_with("--max-pages must be >= 1") if options[:max_pages] < 1
abort_with("adjacent scorer checkout not found: #{SCORER_REPO}") unless File.directory?(File.join(SCORER_REPO, ".git"))

dimensions = qualified.fetch("dimensions")
dimension_names = dimensions.map { |d| d.fetch("name") }
ollama_model = qualified.fetch("ollama_model")
required_adventures = options[:packs] * options[:per_pack]

catalog_path = scorer_catalog_path(SCORER_REPO)
abort_with("configured AMC does not exist: #{catalog_path}") unless File.file?(catalog_path)

require File.join(SCORER_REPO, "lib", "af_scoring", "errors")
require File.join(SCORER_REPO, "lib", "af_scoring", "xlsx_reader")

rows = AFScoring::XlsxReader.new(catalog_path).rows(sheet_name: "Adventure Catalog")
abort_with("AMC Adventure Catalog sheet is empty") if rows.empty?

headers = rows.shift.map { |v| canonical_header(v) }
required_headers = [
  "Adventure ID", "Adventure Title", "Source Book", "Book Publisher",
  "Start Page", "End Page", *dimension_names
]
missing = required_headers - headers
abort_with("AMC missing required columns: #{missing.join(', ')}") unless missing.empty?

reserved = reserved_adventure_ids(ROOT)
audit = []
eligible = []

rows.each do |row|
  values = headers.zip(row).to_h
  id = values["Adventure ID"].to_s.strip
  next if id.empty?

  page_count = integer_or_nil(values["Page Count"])
  start_page = integer_or_nil(values["Start Page"])
  end_page = integer_or_nil(values["End Page"])
  page_count ||= (end_page - start_page + 1) if start_page && end_page && end_page >= start_page

  populated = dimension_names.select { |name| !blank?(values[name]) }
  reason =
    if policy["exclude_reserved_production_adventures"] && reserved.key?(id)
      "reserved:#{reserved.fetch(id)}"
    elsif policy["require_zero_qualified_scores"] && !populated.empty?
      "qualified_scores_present:#{populated.join('|')}"
    elsif page_count.nil? || page_count <= 0
      "page_count_missing"
    elsif page_count > options[:max_pages]
      "page_count_over_limit"
    end

  record = {
    "id" => id,
    "title" => values["Adventure Title"].to_s,
    "source_book" => values["Source Book"].to_s,
    "publisher" => values["Book Publisher"].to_s,
    "page_count" => page_count,
    "start_page" => start_page,
    "end_page" => end_page,
    "populated_qualified_dimensions" => populated
  }

  if reason
    audit << record.merge("decision" => "REJECT", "reason" => reason)
  else
    eligible << record
  end
end

eligible.sort_by! { |r| [r.fetch("page_count"), r.fetch("id")] }

selected = []
eligible.each do |record|
  break if selected.length >= required_adventures

  ok, detail = source_preflight(SCORER_REPO, record.fetch("id"), ollama_model)
  if ok
    selected << record
    audit << record.merge("decision" => "SELECT", "reason" => "source_preflight_pass")
    puts format(
      "SELECT %2d/%d  %-9s  %3d pages  %s",
      selected.length, required_adventures, record.fetch("id"),
      record.fetch("page_count"), record.fetch("title")
    )
  else
    compact = detail.lines.last(4).join(" ").gsub(/\s+/, " ").strip
    audit << record.merge("decision" => "REJECT", "reason" => "source_preflight_failed:#{compact}")
    puts "REJECT source preflight #{record.fetch('id')} — #{record.fetch('title')}"
  end
end

eligible.drop(selected.length).each do |record|
  next if audit.any? { |a| a["id"] == record["id"] }
  audit << record.merge("decision" => "ELIGIBLE_NOT_SELECTED", "reason" => "pilot_capacity_reached")
end

if selected.length < required_adventures
  abort_with(
    "only #{selected.length}/#{required_adventures} source-available adventures satisfied the policy; " \
    "no queue was written"
  )
end

queue_dir = File.join(ROOT, "production_backlog", queue)
experiment_dir = File.join(ROOT, "experiments", queue)

if File.exist?(queue_dir) || File.exist?(experiment_dir)
  abort_with("queue already exists; use --force to replace it") unless options[:force]
  FileUtils.rm_rf(queue_dir)
  FileUtils.rm_rf(experiment_dir)
end

FileUtils.mkdir_p(queue_dir)
FileUtils.mkdir_p(experiment_dir)

snapshot = {
  "version" => 1,
  "queue" => queue,
  "generated_at" => Time.now.iso8601,
  "local_model_eval_commit" => git_head(ROOT),
  "scorer_commit" => git_head(SCORER_REPO),
  "scorer_repo_path" => Pathname.new(SCORER_REPO).relative_path_from(Pathname.new(ROOT)).to_s,
  "catalog_path" => catalog_path,
  "catalog_sha256" => Digest::SHA256.file(catalog_path).hexdigest,
  "model_alias" => qualified.fetch("model_alias"),
  "ollama_model" => ollama_model,
  "packs" => options[:packs],
  "adventures_per_pack" => options[:per_pack],
  "max_page_count" => options[:max_pages],
  "qualified_dimensions" => dimensions,
  "selected_adventures" => selected
}
File.write(File.join(queue_dir, "snapshot.yml"), YAML.dump(snapshot))

audit_headers = %w[
  adventure_id adventure_title source_book publisher page_count
  decision reason
]
CSV.open(File.join(queue_dir, "candidate_audit.csv"), "w") do |csv|
  csv << audit_headers
  audit.sort_by { |r| r["id"] }.each do |r|
    csv << [
      r["id"], r["title"], r["source_book"], r["publisher"], r["page_count"],
      r["decision"], r["reason"]
    ]
  end
end

case_headers = %w[
  case_index pack_index pack_case_index adventure_id adventure_title
  source_book publisher page_count dimension profile manifest_path
]
case_rows = []
all_run_paths = []
scorer_rel = Pathname.new(SCORER_REPO).relative_path_from(Pathname.new(experiment_dir)).to_s
case_index = 0

selected.each_slice(options[:per_pack]).with_index(1) do |pack_adventures, pack_index|
  pack_rows = []
  pack_paths = []

  pack_adventures.each do |adv|
    dimensions.each do |dimension|
      case_index += 1
      filename = "#{queue}-qwen-#{dimension.fetch('slug')}-adv#{adv.fetch('id').split('-').last.downcase}-v1.yml"
      relative_path = File.join("experiments", queue, filename)
      File.write(
        File.join(experiment_dir, filename),
        yaml_manifest(queue: queue, adv: adv, dimension: dimension, scorer_rel: scorer_rel)
      )
      row = [
        case_index, pack_index, pack_rows.length + 1,
        adv.fetch("id"), adv.fetch("title"), adv.fetch("source_book"),
        adv.fetch("publisher"), adv.fetch("page_count"),
        dimension.fetch("name"), dimension.fetch("profile"), relative_path
      ]
      case_rows << row
      pack_rows << row
      pack_paths << relative_path
      all_run_paths << relative_path
    end
  end

  pack_name = format("pack-%03d", pack_index)
  CSV.open(File.join(queue_dir, "#{pack_name}_case_index.csv"), "w") do |csv|
    csv << case_headers
    pack_rows.each { |row| csv << row }
  end
  File.write(File.join(queue_dir, "#{pack_name}_run_order.txt"), pack_paths.join("\n") + "\n")
end

CSV.open(File.join(queue_dir, "case_index.csv"), "w") do |csv|
  csv << case_headers
  case_rows.each { |row| csv << row }
end
File.write(File.join(queue_dir, "run_order.txt"), all_run_paths.join("\n") + "\n")

expected_calls = required_adventures * dimensions.length
avg_seconds_per_call = 352.0 * 60.0 / 128.0
estimated_hours = expected_calls * avg_seconds_per_call / 3600.0

puts
puts "PRODUCTION BACKLOG PREPARED — NO INFERENCE WAS RUN"
puts "Queue: #{File.join('production_backlog', queue)}"
puts "Adventures: #{required_adventures}"
puts "Dimensions: #{dimensions.length}"
puts "Calls: #{expected_calls}"
puts "Packs: #{options[:packs]} × #{options[:per_pack]} adventures"
puts "Max source pages: #{options[:max_pages]}"
puts format("Planning runtime from recent throughput: ~%.1f hours", estimated_hours)
puts "Scorer checkout: #{SCORER_REPO}"
puts "External/API inference cost: $0"
puts
puts "Next:"
puts "  ./verify_production_backlog.sh production_backlog/#{queue}"
